<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="chassis" params="">
    <!-- Massless reference frame for rear-drive Ackermann odometry and Pure Pursuit. -->
    <link name="rear_axle"/>
    <joint name="rear_axle_to_base_link" type="fixed">
      <parent link="rear_axle"/>
      <child link="base_link"/>
      <origin xyz="${wheelbase / 2} 0 0" rpy="0 0 0"/>
    </joint>

    <!-- base_link is midway between the axles, at wheel-axle height.
         The body geometry and estimated center of mass are raised above it. -->
    <link name="base_link">
      <visual>
        <origin xyz="0 0 ${chassis_center_z}"/>
        <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
        <material name="chassis_white"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${chassis_center_z}"/>
        <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${chassis_center_z}"/>
        <mass value="${chassis_mass}"/>
        <!-- Solid rectangular box, principal inertia about its center. -->
        <inertia
          ixx="${chassis_mass * (chassis_width**2 + chassis_height**2) / 12.0}"
          ixy="0" ixz="0"
          iyy="${chassis_mass * (chassis_length**2 + chassis_height**2) / 12.0}"
          iyz="0"
          izz="${chassis_mass * (chassis_length**2 + chassis_width**2) / 12.0}"/>
      </inertial>
    </link>
  </xacro:macro>
</robot>

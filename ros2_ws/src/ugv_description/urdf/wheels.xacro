<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Reusable link geometry for all four wheels. Wheel axle is local Y. -->
  <xacro:macro name="wheel_body" params="name">
    <link name="${name}">
      <visual>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <!-- Solid cylinder aligned with local Y, not Z. -->
        <inertia
          ixx="${wheel_mass * (3*wheel_radius**2 + wheel_width**2) / 12.0}"
          ixy="0" ixz="0"
          iyy="${wheel_mass * wheel_radius**2 / 2.0}"
          iyz="0"
          izz="${wheel_mass * (3*wheel_radius**2 + wheel_width**2) / 12.0}"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="front_wheel" params="side x y">
    <!-- An invisible but physical steering knuckle (nonzero inertia). -->
    <link name="front_${side}_steering_link">
      <inertial>
        <mass value="0.5"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>
    <joint name="front_${side}_steering_joint" type="revolute">
      <parent link="base_link"/>
      <child link="front_${side}_steering_link"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-steering_limit}" upper="${steering_limit}" effort="30" velocity="1.2"/>
      <dynamics damping="0.1" friction="0.0"/>
    </joint>

    <xacro:wheel_body name="front_${side}_wheel_link"/>
    <joint name="front_${side}_wheel_joint" type="continuous">
      <parent link="front_${side}_steering_link"/>
      <child link="front_${side}_wheel_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="60" velocity="35"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="rear_wheel" params="side x y">
    <xacro:wheel_body name="rear_${side}_wheel_link"/>
    <joint name="rear_${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="rear_${side}_wheel_link"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="60" velocity="35"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>
  </xacro:macro>
</robot>
